# Демо Clinical Compass: пациент и врач в одном процессе Fastify.
# Развёрнуто на pc как пользовательский юнит (denis), проксируется Caddy с pi:
# compas.sudakov.site -> 192.168.1.20:8110.
[Unit]
Description=Clinical Compass demo (patient + doctor)
After=network-online.target

[Service]
WorkingDirectory=/home/denis/apps/clinical-compass
ExecStart=/home/denis/apps/clinical-compass/node_modules/.bin/tsx server/index.ts
Environment=NODE_ENV=production
Environment=PORT=8110
Environment=HOST=0.0.0.0
Environment=SQLITE_DB=/home/denis/apps/clinical-compass/var/demo.db
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
